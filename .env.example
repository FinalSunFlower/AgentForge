APP_ENV=development
LOG_LEVEL=INFO
# Local profile: SQLite. Production profile: postgresql+asyncpg://... (Neon or Railway Postgres).
DATABASE_URL=sqlite+aiosqlite:///./agentforge.local.db
# Production profile: Upstash or Railway Redis. Empty keeps the local durable SQL adapter.
REDIS_URL=
AGENT_RUNTIME_URL=http://localhost:8101
# Shared secret between Core API and Runtime. Must match on both processes.
RUNTIME_INTERNAL_TOKEN=local-runtime-token-change-me
JWT_SECRET=local-development-secret-change-me
JWT_EXPIRE_MINUTES=30
# HMAC secret for /v1/webhooks/billing (test billing slice).
WEBHOOK_SIGNING_SECRET=local-webhook-secret-change-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Prefer a cheap public-demo model (gpt-4o-mini or a Groq-hosted Llama).
LLM_MODEL=
# Public-demo abuse controls. Leave false for local development.
DEMO_MODE=false
DAILY_TOKEN_BUDGET=200000
DEMO_RUNS_PER_IP_PER_HOUR=5
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUN_MAX_STEPS=8
RUN_MAX_TOOL_DEPTH=6
RUN_TIMEOUT_SECONDS=120
RUN_MAX_CONTEXT_CHARS=120000
RUN_KEEP_RECENT_MESSAGES=6
RUN_COMPRESS_AFTER_MESSAGES=12
RUN_MAX_INPUT_TOKENS=128000
RUN_MAX_COST_MICROS=1000000
# Integer micro-USD per 1M input/output tokens. Keep zero for a free/local provider.
MODEL_INPUT_COST_PER_1M_MICROS=0
MODEL_OUTPUT_COST_PER_1M_MICROS=0
EVENT_STREAM_MAXLEN=10000
EVENT_STREAM_RETENTION_SECONDS=86400
# OpenTelemetry: console spans via env, OTLP via endpoint. Service names are hardcoded per process.
OTEL_CONSOLE_EXPORTER=false
# Optional override for MiniLM + MS MARCO MiniLM-L-6 ONNX cache (CPU).
# FASTEMBED_CACHE_PATH=
